    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ (() => {\n  const body = $('VisionFind Website Webhook').first().json.body || {};\n  const faults = [];\n  const feature = String(body.feature || '').trim().toLowerCase();\n\n  if (!feature) {\n    faults.push({ field: 'feature', problem: 'Feature is missing', expected: 'witness or map' });\n  } else if (!['witness', 'map'].includes(feature)) {\n    faults.push({ field: 'feature', problem: `Unsupported feature: ${body.feature}`, expected: 'witness or map' });\n  }\n\n  if (!String(body.case_id || '').trim()) {\n    faults.push({ field: 'case_id', problem: 'Case ID is missing', expected: 'A value such as VF001' });\n  }\n\n  return {\n    success: false,\n    error: 'Request validation failed',\n    fault_location: 'Request validation or feature routing',\n    faults\n  };\n})() }}",
        "options": {
          "responseCode": 400
        }
      },
